root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,jsonc,js,jsx,ts,tsx,css,html,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
